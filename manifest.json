{
  "manifest_version": 3,
  "name": "Daily Git Checker",
  "version": "1.0",
  "description": "Check daily git commits from Google Sheets",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://sheets.googleapis.com/*",
    "https://gitlab.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/jsencrypt.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
